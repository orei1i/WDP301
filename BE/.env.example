# Sao chép thành BE/.env rồi điền giá trị thật:  cp BE/.env.example BE/.env
# BE/.env đã nằm trong .gitignore — khoá service account Firebase là quyền admin, không commit.

# ---- bắt buộc
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/selfstorage?retryWrites=true&w=majority
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- tuỳ chọn (bỏ dấu # để đổi; giá trị ghi sẵn là mặc định)
# PORT=4000
# CORS_ORIGINS=http://localhost:3000        # nhiều origin cách nhau bằng dấu phẩy — thêm domain Webapp đã deploy
# SEED_PASSWORD=Demo@12345                  # mật khẩu các tài khoản demo do `npm run seed` tạo (>= 8 ký tự)
# FIREBASE_WEB_API_KEY=                     # có thì trang /api có ô đăng nhập lấy token
# DOC_DEMO_PASSWORD=                        # CẢNH BÁO: công bố mật khẩu demo trên trang /api công khai — chỉ dùng với DB demo
# AUTH_DEV_BYPASS=false                     # chỉ để dev: nhận header x-dev-user. Bị bỏ qua khi NODE_ENV=production
